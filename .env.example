# Supabase Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase Project Settings > API Keys > publishable or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server-only secret from Supabase. NEVER prefix with NEXT_PUBLIC_ or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# V4: Set true ONLY after confirming official garment prices and delivery policy.
CHECKOUT_PRICING_CONFIRMED=false
# GCash / QR Ph: PayMongo merchant secret, optional until configured.
# PAYMONGO_SECRET_KEY=sk_test_YOUR_KEY
# PAYMONGO_WEBHOOK_SECRET=YOUR_SIGNING_SECRET
